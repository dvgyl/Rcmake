=== CASE minimum-required-3-5 ===
# args: -P script.cmake
-- script.cmake --
cmake_minimum_required(VERSION 3.5)
cmake_policy(GET CMP0054 quoted_if)
message(STATUS "minimum=${CMAKE_MINIMUM_REQUIRED_VERSION} CMP0054=${quoted_if}")
=== CASE minimum-required-version-range ===
# args: -P script.cmake
-- script.cmake --
cmake_minimum_required(VERSION 3.0...4.5)
cmake_policy(GET CMP0186 regex_policy)
message(STATUS "minimum=${CMAKE_MINIMUM_REQUIRED_VERSION} CMP0186=${regex_policy}")
