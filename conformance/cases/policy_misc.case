=== CASE policy-version-and-stack ===
# args: -P script.cmake
-- script.cmake --
cmake_policy(VERSION 3.20)
cmake_policy(GET CMP0186 outer)
cmake_policy(PUSH)
cmake_policy(SET CMP0186 NEW)
cmake_policy(GET CMP0186 inner)
cmake_policy(POP)
cmake_policy(GET CMP0186 restored)
message(STATUS "outer=[${outer}] inner=${inner} restored=[${restored}]")
=== CASE diagnostic-actions-and-stack ===
# args: -P script.cmake
-- script.cmake --
cmake_diagnostic(SET CMD_AUTHOR WARN)
cmake_diagnostic(GET CMD_AUTHOR outer)
cmake_diagnostic(PUSH)
cmake_diagnostic(PROMOTE CMD_AUTHOR SEND_ERROR NO_RECURSE)
cmake_diagnostic(PROMOTE CMD_AUTHOR WARN NO_RECURSE)
cmake_diagnostic(GET CMD_AUTHOR promoted)
cmake_diagnostic(DEMOTE CMD_AUTHOR IGNORE NO_RECURSE)
cmake_diagnostic(DEMOTE CMD_AUTHOR WARN NO_RECURSE)
cmake_diagnostic(GET CMD_AUTHOR demoted)
message(AUTHOR_WARNING "Suppressed by CMD_AUTHOR")
cmake_diagnostic(POP)
cmake_diagnostic(GET CMD_AUTHOR restored)
message(STATUS "outer=${outer} promoted=${promoted} demoted=${demoted} restored=${restored}")
=== CASE parse-arguments-keywords-and-missing-values ===
# args: -P script.cmake
-- script.cmake --
cmake_parse_arguments(arg "VERBOSE;QUIET" "NAME;TARGET" "FILES" extra VERBOSE NAME demo FILES a b TARGET)
message(STATUS "options=${arg_VERBOSE}/${arg_QUIET} name=${arg_NAME} files=${arg_FILES}")
message(STATUS "unparsed=${arg_UNPARSED_ARGUMENTS} missing=${arg_KEYWORDS_MISSING_VALUES}")
=== CASE parse-argv-semicolons-and-empty-value ===
# args: -P script.cmake
-- script.cmake --
cmake_minimum_required(VERSION 4.5)
function(parse ignored)
  cmake_parse_arguments(PARSE_ARGV 1 arg "ONCE" "NAME" "ITEMS")
  list(LENGTH arg_ITEMS length)
  list(GET arg_ITEMS 0 first)
  message(STATUS "once=${arg_ONCE} length=${length} first=[${first}]")
  if(DEFINED arg_NAME)
    message(STATUS "name defined as [${arg_NAME}]")
  endif()
endfunction()
parse(skip ONCE ITEMS "a;b" c NAME "")
=== CASE parse-argn-skips-named-parameters ===
# args: -P script.cmake
-- script.cmake --
function(parse first second)
  cmake_parse_arguments(PARSE_ARGN arg "FAST" "LABEL" "ITEMS")
  list(GET arg_ITEMS 0 item)
  message(STATUS "fast=${arg_FAST} label=${arg_LABEL} item=[${item}] extras=[${arg_UNPARSED_ARGUMENTS}]")
endfunction()
parse(FAST LABEL stray LABEL "two words" ITEMS "a;b")
=== CASE configure-file-at-only-and-escaped-quotes ===
# args: -P script.cmake
# check_files: true
-- script.cmake --
set(ENABLED ON)
set(DISABLED OFF)
set(TITLE [=[A "quote"]=])
configure_file(input.in out/config.h @ONLY ESCAPE_QUOTES)
-- input.in --
#cmakedefine ENABLED "@TITLE@"
#cmakedefine DISABLED disabled
#cmakedefine01 ENABLED
#cmakedefine01 DISABLED
at=@TITLE@
dollar=${TITLE}
