=== CASE filename-components ===
# args: -P script.cmake
-- script.cmake --
get_filename_component(dir "/work/pkg/archive.tar.gz" DIRECTORY)
get_filename_component(name "/work/pkg/archive.tar.gz" NAME)
get_filename_component(stem "/work/pkg/archive.tar.gz" NAME_WE)
get_filename_component(ext "/work/pkg/archive.tar.gz" EXT)
get_filename_component(last "/work/pkg/archive.tar.gz" LAST_EXT)
get_filename_component(abs "../out/./file" ABSOLUTE BASE_DIR "/work/pkg")
message(STATUS "dir=${dir} name=${name} stem=${stem} ext=${ext} last=${last} abs=${abs}")
=== CASE property-definition-rejected-in-script ===
# args: -P script.cmake
-- script.cmake --
define_property(GLOBAL PROPERTY SAMPLE BRIEF_DOCS "Short help")
=== CASE property-definition-and-value ===
# args: -N -C preload.cmake -G "Unix Makefiles" -S . -B build
-- preload.cmake --
define_property(GLOBAL PROPERTY SAMPLE BRIEF_DOCS "Short help" FULL_DOCS "Full help")
get_property(defined GLOBAL PROPERTY SAMPLE DEFINED)
get_property(initial GLOBAL PROPERTY SAMPLE SET)
get_property(help GLOBAL PROPERTY SAMPLE BRIEF_DOCS)
set_property(GLOBAL PROPERTY SAMPLE first)
set_property(GLOBAL APPEND PROPERTY SAMPLE second third)
set_property(GLOBAL APPEND_STRING PROPERTY SAMPLE "!")
get_property(value GLOBAL PROPERTY SAMPLE)
message(STATUS "defined=${defined} initial=${initial} help=${help} value=${value}")
=== CASE property-set-and-get-in-script ===
# args: -P script.cmake
-- script.cmake --
get_property(initial GLOBAL PROPERTY SAMPLE SET)
set_property(GLOBAL PROPERTY SAMPLE first)
set_property(GLOBAL APPEND PROPERTY SAMPLE second third)
set_property(GLOBAL APPEND_STRING PROPERTY SAMPLE "!")
get_property(value GLOBAL PROPERTY SAMPLE)
get_property(now_set GLOBAL PROPERTY SAMPLE SET)
set_property(GLOBAL PROPERTY SAMPLE)
get_property(cleared GLOBAL PROPERTY SAMPLE SET)
message(STATUS "initial=${initial} value=${value} set=${now_set} cleared=${cleared}")
=== CASE language-call-eval-and-log-level ===
# args: --log-level=VERBOSE -P script.cmake
-- script.cmake --
set(command set)
cmake_language(CALL "${command}" value called)
cmake_language(EVAL CODE [=[string(APPEND value "-evaluated")]=])
cmake_language(GET_MESSAGE_LOG_LEVEL log_level)
message(VERBOSE "value=${value} level=${log_level}")
message(DEBUG "below configured log level")
