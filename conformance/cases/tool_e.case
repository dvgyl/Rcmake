=== CASE e-compare-files-ignore-eol ===
# args: -P script.cmake
-- script.cmake --
file(WRITE lf "first\nsecond\n")
file(WRITE crlf "first\r\nsecond\r\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files lf crlf RESULT_VARIABLE strict)
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files --ignore-eol lf crlf RESULT_VARIABLE ignore)
message(STATUS "strict=${strict} ignore-eol=${ignore}")
