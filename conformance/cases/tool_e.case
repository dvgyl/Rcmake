=== CASE e-tar-gzip-create-list-extract ===
# args: -P script.cmake
# check_files: true
-- script.cmake --
execute_process(
  COMMAND "${CMAKE_COMMAND}" -E tar cfz bundle.tar.gz --mtime=2020-01-02 assets
  RESULT_VARIABLE create
)
if(create EQUAL 0)
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E tar tfz bundle.tar.gz
    OUTPUT_VARIABLE entries RESULT_VARIABLE list
  )
  file(MAKE_DIRECTORY unpacked)
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E tar xfz ../bundle.tar.gz
    WORKING_DIRECTORY unpacked RESULT_VARIABLE extract
  )
  file(REMOVE bundle.tar.gz)
endif()
message(STATUS "create=${create} list=${list} extract=${extract} entries=[${entries}]")
-- assets/payload.txt --
A gzip payload.
