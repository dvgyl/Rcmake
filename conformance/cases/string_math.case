=== CASE string-find-and-replace ===
# args: -P script.cmake
-- script.cmake --
string(FIND "ababa" "ba" first)
string(FIND "ababa" "ba" last REVERSE)
string(FIND "ababa" "z" missing)
string(REPLACE "ab" "X" replaced "a" "ba" "ba")
message(STATUS "first=${first} last=${last} missing=${missing} result=${replaced}")
=== CASE regex-captures-and-backreferences ===
# args: -P script.cmake
-- script.cmake --
string(REGEX MATCH "([a-z]+)-([0-9]+)" match "left-42 right-8")
message(STATUS "match=${match} captures=${CMAKE_MATCH_1}/${CMAKE_MATCH_2} count=${CMAKE_MATCH_COUNT}")
string(REGEX MATCHALL "[0-9]+" all "left-42 right-8")
string(REGEX REPLACE "([a-z]+)-([0-9]+)" [[\2:\1]] swapped "left-42 right-8")
message(STATUS "all=${all} swapped=${swapped}")
=== CASE regex-anchor-cmp0186 ===
# args: -P script.cmake
-- script.cmake --
cmake_minimum_required(VERSION 4.5)
string(REGEX MATCHALL "^z" new_matches "zzzt")
string(REGEX REPLACE "^z" "X" new_replaced "zzzt")
cmake_policy(SET CMP0186 OLD)
string(REGEX MATCHALL "^z" old_matches "zzzt")
string(REGEX REPLACE "^z" "X" old_replaced "zzzt")
message(STATUS "new=${new_matches}/${new_replaced} old=${old_matches}/${old_replaced}")
=== CASE regex-empty-match-retry ===
# args: -P script.cmake
-- script.cmake --
cmake_minimum_required(VERSION 4.5)
string(REGEX MATCH "^" first "ba")
string(REGEX MATCHALL "a*" all "ba")
string(REGEX REPLACE "a*" "X" replaced "ba")
message(STATUS "first=[${first}] all=[${all}] replaced=${replaced}")
=== CASE string-combine ===
# args: -P script.cmake
-- script.cmake --
set(value mid)
string(APPEND value d le)
string(PREPEND value pre -)
string(CONCAT joined a "" c)
string(JOIN "|" delimited "a;b" "" c)
message(STATUS "value=${value} concat=${joined} join=${delimited}")
=== CASE string-case-and-byte-indexes ===
# args: -P script.cmake
-- script.cmake --
string(TOLOWER "CaSe" lower)
string(TOUPPER "CaSe" upper)
string(LENGTH "aéz" bytes)
string(SUBSTRING "aéz" 1 2 accent)
string(SUBSTRING "padded" 3 -1 tail)
message(STATUS "case=${lower}/${upper} bytes=${bytes} accent=${accent} tail=${tail}")
=== CASE string-strip-genex-and-repeat ===
# args: -P script.cmake
-- script.cmake --
string(STRIP " \t  padded \t\n" stripped)
string(GENEX_STRIP "left$<IF:$<BOOL:1>,yes,no>right" literal)
string(REPEAT "${stripped}," 3 repeated)
message(STATUS "strip=[${stripped}] literal=${literal} repeated=${repeated}")
=== CASE string-compare ===
# args: -P script.cmake
-- script.cmake --
string(COMPARE LESS "A" "a" less)
string(COMPARE GREATER_EQUAL "8" "8" ge)
string(COMPARE EQUAL "01" "1" equal)
string(COMPARE NOTEQUAL "same" "same" different)
message(STATUS "less=${less} ge=${ge} equal=${equal} different=${different}")
=== CASE string-hashes ===
# args: -P script.cmake
-- script.cmake --
string(MD5 md5 "wave three")
string(SHA1 sha1 "wave three")
string(SHA256 sha256 "wave three")
string(SHA3_256 sha3 "wave three")
message(STATUS "md5=${md5} sha1=${sha1} sha256=${sha256} sha3=${sha3}")
=== CASE string-ascii-hex-and-identifier ===
# args: -P script.cmake
-- script.cmake --
string(ASCII 65 10 90 letters)
string(HEX "${letters}é" hex)
string(MAKE_C_IDENTIFIER "9 spaces-and.dots" identifier)
message(STATUS "hex=${hex} id=${identifier}")
=== CASE string-configure ===
# args: -P script.cmake
-- script.cmake --
set(value [=[a"b]=])
string(CONFIGURE [=[@value@|${value}|@missing@]=] at_only @ONLY ESCAPE_QUOTES)
string(CONFIGURE [=[@value@|${value}|@missing@]=] both)
message(STATUS "at-only=${at_only}")
message(STATUS "both=${both}")
=== CASE string-name-based-uuid ===
# args: -P script.cmake
-- script.cmake --
set(ns 6ba7b810-9dad-11d1-80b4-00c04fd430c8)
string(UUID md5 NAMESPACE "${ns}" NAME "build.example" TYPE MD5)
string(UUID sha1 NAMESPACE "${ns}" NAME "build.example" TYPE SHA1 UPPER)
message(STATUS "md5=${md5} sha1=${sha1}")
=== CASE string-timestamp-source-date-epoch ===
# args: -P script.cmake
# env: SOURCE_DATE_EPOCH=1709164800
-- script.cmake --
string(TIMESTAMP iso UTC)
string(TIMESTAMP fields "%Y-%m-%d %H:%M:%S %j %s %z" UTC)
message(STATUS "iso=${iso} fields=${fields}")
=== CASE json-get-raw-and-type ===
# args: -P script.cmake
-- script.cmake --
set(doc [=[{"items":[true,null,"a;b"]}]=])
string(JSON value GET "${doc}" items 0)
string(JSON raw GET_RAW "${doc}" items 0)
string(JSON null GET "${doc}" items 1)
string(JSON text GET_RAW "${doc}" items 2)
string(JSON kind TYPE "${doc}" items 1)
message(STATUS "value=${value} raw=${raw} null=[${null}] text=${text} type=${kind}")
=== CASE json-member-length-and-missing ===
# args: -P script.cmake
-- script.cmake --
set(doc [=[{"z":0,"a":[2,3]}]=])
string(JSON key MEMBER "${doc}" 0)
string(JSON size LENGTH "${doc}" a)
string(JSON missing ERROR_VARIABLE error GET "${doc}" absent)
message(STATUS "key=${key} size=${size} missing=${missing} error=${error}")
=== CASE json-set-remove-and-equal ===
# args: -P script.cmake
-- script.cmake --
set(doc [=[{"items":[1,2,3],"discard":true}]=])
string(JSON changed SET "${doc}" items 1 [=["new"]=])
string(JSON changed REMOVE "${changed}" discard)
string(JSON changed REMOVE "${changed}" items 0)
string(JSON equal EQUAL "${changed}" [=[{"items":["new",3]}]=])
string(JSON different EQUAL "${changed}" [=[{"items":[3,"new"]}]=])
message(STATUS "doc=${changed}")
message(STATUS "equal=${equal} reversed=${different}")
=== CASE math-decimal-precedence ===
# args: -P script.cmake
-- script.cmake --
math(EXPR precedence "2 + 3 * 4")
math(EXPR grouped "(2 + 3) * 4")
math(EXPR quotient "-17 / 5")
math(EXPR remainder "-17 % 5")
message(STATUS "precedence=${precedence} grouped=${grouped} quotient=${quotient} remainder=${remainder}")
=== CASE math-hex-and-bitwise ===
# args: -P script.cmake
-- script.cmake --
math(EXPR decimal "(0x42 | 1) ^ 3")
math(EXPR hex "((0xAB & 0x0F) << 2) | (0x20 >> 4)" OUTPUT_FORMAT HEXADECIMAL)
math(EXPR complement "~0")
math(EXPR negative "-0x2a" OUTPUT_FORMAT HEXADECIMAL)
message(STATUS "decimal=${decimal} hex=${hex} complement=${complement} negative=${negative}")
