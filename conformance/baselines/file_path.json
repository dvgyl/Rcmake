  "file-links-and-real-path": {
    "exit_code": 0,
    "stdout": "-- soft=0 hard=0 target=payload.txt real=<TMP>/payload.txt shared=[Before.\nafter\n]\n",
    "stderr": "",
    "files": {
      "hard.txt": {
        "kind": "file",
        "content": "Before.\nafter\n"
      },
      "payload.txt": {
        "kind": "file",
        "content": "Before.\nafter\n"
      },
      "script.cmake": {
        "kind": "file",
        "content": "file(CREATE_LINK payload.txt soft.txt SYMBOLIC RESULT soft)\nfile(CREATE_LINK \"${CMAKE_CURRENT_SOURCE_DIR}/payload.txt\" hard.txt RESULT hard)\nfile(READ_SYMLINK soft.txt target)\nfile(REAL_PATH soft.txt real BASE_DIRECTORY \"${CMAKE_CURRENT_SOURCE_DIR}\")\nfile(APPEND payload.txt \"after\\n\")\nfile(READ hard.txt shared)\nmessage(STATUS \"soft=${soft} hard=${hard} target=${target} real=${real} shared=[${shared}]\")\n"
      },
      "soft.txt": {
        "kind": "symlink",
        "target": "payload.txt"
      }
    }
  },
