.\" SPDX-License-Identifier: MIT OR Apache-2.0
.TH RCMAKE 1 "2026-11-28" "rcmake 0.2.1" "User Commands"
.SH NAME
rcmake \- native Rust CMake 4.5.1 compatible build system driver
.SH SYNOPSIS
