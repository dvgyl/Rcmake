{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dvgyl.github.io/rcmake/data/dashboard.schema.json",
  "title": "Rcmake Nightly Compatibility Dashboard Snapshot",
  "description": "Schema for site/data/latest.json driving the Rcmake landing proof strip and 7-track compatibility dashboard.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "commit",
    "rcmakeVersion",
    "targetCmakeVersion",
    "tracks"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": {
      "type": ["string", "null"],
      "description": "ISO-8601 UTC timestamp of the snapshot, or null before final run."
    },
    "commit": {
      "type": ["string", "null"],
      "description": "Short or full Git commit SHA for the verified binary."
    },
    "binarySha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Optional SHA-256 hex digest of the frozen release binary measured across all receipts."
    },
    "rcmakeVersion": { "type": "string" },
    "targetCmakeVersion": { "type": "string" },
    "statusNote": { "type": "string" },
    "knownParityGaps": {
      "type": ["array", "string", "null"],
      "items": { "type": "string" },
      "description": "Optional list or summary of known parity gaps from the frozen release verification run."
    },
    "receipt": { "$ref": "#/$defs/releaseReceipt" },
    "tracks": {
      "type": "object",
      "required": [
        "coreConformance",
        "policies",
        "runCmakeOs",
        "bossFight",
        "unseenHoldout",
        "vcpkgMatrix",
        "benchmarksAndGates"
      ],
      "properties": {
        "coreConformance": {
          "type": "object",
          "required": [
            "label",
            "status",
            "suitesTotal",
            "suitesAt100",
            "casesPassed",
            "casesTotal",
            "passRate",
            "highlights"
          ],
          "properties": {
            "label": { "type": "string" },
            "status": { "$ref": "#/$defs/status" },
            "suitesTotal": { "type": "integer", "minimum": 1 },
            "suitesAt100": { "type": ["integer", "null"], "minimum": 0 },
            "casesPassed": { "type": ["integer", "null"], "minimum": 0 },
            "casesTotal": { "type": ["integer", "null"], "minimum": 0 },
            "passRate": { "$ref": "#/$defs/rate" },
            "note": { "type": "string" },
            "highlights": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["suite", "passed", "total", "status"],
                "properties": {
                  "suite": { "type": "string" },
                  "passed": { "type": ["integer", "null"], "minimum": 0 },
                  "total": { "type": ["integer", "null"], "minimum": 0 },
                  "status": { "$ref": "#/$defs/status" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "policies": {
          "type": "object",
          "required": [
            "label",
            "status",
            "baselineAlwaysNew",
            "activeRange",
            "suitesTotal",
            "suitesPassed",
            "casesPassed",
            "casesTotal",
            "passRate"
          ],
          "properties": {
            "label": { "type": "string" },
            "status": { "$ref": "#/$defs/status" },
            "baselineAlwaysNew": { "type": "string" },
            "activeRange": { "type": "string" },
            "suitesTotal": { "type": "integer", "minimum": 1 },
            "suitesPassed": { "type": ["integer", "null"], "minimum": 0 },
            "casesPassed": { "type": ["integer", "null"], "minimum": 0 },
            "casesTotal": { "type": ["integer", "null"], "minimum": 0 },
            "passRate": { "$ref": "#/$defs/rate" },
            "note": { "type": "string" }
          }
        },
        "runCmakeOs": {
          "type": "object",
          "required": ["label", "status", "platforms"],
          "properties": {
            "label": { "type": "string" },
            "status": { "$ref": "#/$defs/status" },
            "note": { "type": "string" },
            "platforms": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "toolchain",
                  "suitesTotal",
                  "suitesPassed",
                  "casesPassed",
                  "casesTotal",
                  "passRate",
                  "status"
                ],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "toolchain": { "type": "string" },
                  "suitesTotal": { "type": "integer", "minimum": 1 },
                  "suitesPassed": { "type": ["integer", "null"], "minimum": 0 },
                  "casesPassed": { "type": ["integer", "null"], "minimum": 0 },
                  "casesTotal": { "type": ["integer", "null"], "minimum": 0 },
                  "passRate": { "$ref": "#/$defs/rate" },
                  "status": { "$ref": "#/$defs/status" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "bossFight": {
          "type": "object",
          "required": ["label", "status", "projectsTotal", "l1Passed", "l2Passed", "projects"],
          "properties": {
            "label": { "type": "string" },
            "status": { "$ref": "#/$defs/status" },
            "projectsTotal": { "type": "integer", "minimum": 1 },
            "l1Passed": { "type": ["integer", "null"], "minimum": 0 },
            "l2Passed": { "type": ["integer", "null"], "minimum": 0 },
            "l3Passed": { "type": ["integer", "null"], "minimum": 0 },
            "l4Passed": { "type": ["integer", "null"], "minimum": 0 },
            "note": { "type": "string" },
            "projects": {
              "type": "array",
              "minItems": 10,
              "items": {
                "type": "object",
                "required": ["name", "repository", "version", "tier", "targets", "l1", "l2"],
                "properties": {
                  "name": { "type": "string" },
                  "repository": { "type": "string" },
                  "version": { "type": "string" },
                  "tier": { "type": "string", "enum": ["standard", "large"] },
                  "targets": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "l1": { "$ref": "#/$defs/status" },
                  "l2": { "$ref": "#/$defs/status" },
                  "l3": { "$ref": "#/$defs/status" },
                  "l4": { "$ref": "#/$defs/status" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "unseenHoldout": {
          "type": "object",
          "description": "Aggregate metrics only. Repository names must never appear in this section.",
          "required": [
            "label",
            "sealed",
            "status",
            "reposTotal",
            "reposPassed",
            "passRate",
            "policy",
            "categories"
          ],
          "properties": {
            "label": { "type": "string" },
            "sealed": { "type": "boolean", "const": true },
            "status": { "$ref": "#/$defs/status" },
            "reposTotal": { "type": "integer", "minimum": 1 },
            "reposPassed": { "type": ["integer", "null"], "minimum": 0 },
            "passRate": { "$ref": "#/$defs/rate" },
            "policy": { "type": "string" },
            "note": { "type": "string" },
            "categories": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["category", "reposTotal", "reposPassed", "passRate", "status"],
                "properties": {
                  "category": { "type": "string" },
                  "reposTotal": { "type": ["integer", "null"], "minimum": 0 },
                  "reposPassed": { "type": ["integer", "null"], "minimum": 0 },
                  "passRate": { "$ref": "#/$defs/rate" },
                  "status": { "$ref": "#/$defs/status" }
                }
              }
            }
          }
        },
        "vcpkgMatrix": {
          "type": "object",
          "required": [
            "label",
            "status",
            "shardsTotal",
            "shardsCompleted",
            "shardsPassed",
            "portsTotal",
            "portsPassed",
            "passRate",
            "shards"
          ],
          "properties": {
            "label": { "type": "string" },
            "status": { "$ref": "#/$defs/status" },
            "shardsTotal": { "type": "integer", "const": 64 },
            "shardsCompleted": { "type": "integer", "minimum": 0, "maximum": 64 },
            "shardsPassed": { "type": ["integer", "null"], "minimum": 0, "maximum": 64 },
            "portsTotal": { "type": ["integer", "null"], "minimum": 0 },
            "portsPassed": { "type": ["integer", "null"], "minimum": 0 },
            "passRate": { "$ref": "#/$defs/rate" },
            "note": { "type": "string" },
            "shards": {
              "type": "array",
              "minItems": 64,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": ["shard", "status", "portsTotal", "portsPassed", "durationSeconds"],
                "properties": {
                  "shard": { "type": "integer", "minimum": 0, "maximum": 63 },
                  "status": { "$ref": "#/$defs/status" },
                  "portsTotal": { "type": ["integer", "null"], "minimum": 0 },
                  "portsPassed": { "type": ["integer", "null"], "minimum": 0 },
                  "portsFailed": { "type": ["integer", "null"], "minimum": 0 },
                  "durationSeconds": { "type": ["number", "null"], "minimum": 0 },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "benchmarksAndGates": {
          "type": "object",
          "required": ["label", "benchmarks", "gates"],
          "properties": {
            "label": { "type": "string" },
            "benchmarks": {
              "type": "object",
              "required": [
                "warmProbeSpeedup",
                "incrementalLeafP95Ms",
                "coldConfigureSpeedup",
                "peakRssMiB"
              ],
              "properties": {
                "warmProbeSpeedup": { "$ref": "#/$defs/benchmarkMetric" },
                "incrementalLeafP95Ms": { "$ref": "#/$defs/benchmarkMetric" },
                "coldConfigureSpeedup": { "$ref": "#/$defs/benchmarkMetric" },
                "peakRssMiB": { "$ref": "#/$defs/benchmarkMetric" },
                "realGiantWarmSpeedup": { "$ref": "#/$defs/benchmarkMetric" },
                "realGiantColdSpeedup": { "$ref": "#/$defs/benchmarkMetric" },
                "realGiantLeafP95Ms": { "$ref": "#/$defs/benchmarkMetric" }
              }
            },
            "realGiants": {
              "type": "array",
              "description": "Optional per-project benchmark measurements across real-world large C++ projects.",
              "items": { "$ref": "#/$defs/realGiantBenchmark" }
            },
            "differentialFuzz": {
              "$ref": "#/$defs/differentialFuzzReport",
              "description": "Optional seeded differential property-testing summary from oracle_prop_test.py."
            },
            "gates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label", "status", "passed", "total", "failures", "summary", "detail"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "status": { "$ref": "#/$defs/status" },
                  "passed": { "type": ["integer", "null"], "minimum": 0 },
                  "total": { "type": ["integer", "null"], "minimum": 0 },
                  "failures": { "type": ["integer", "null"], "minimum": 0 },
                  "scenariosPassed": { "type": ["integer", "null"], "minimum": 0 },
                  "scenariosTotal": { "type": ["integer", "null"], "minimum": 0 },
                  "seed": { "type": ["integer", "null"] },
                  "oracleErrors": { "type": ["integer", "null"], "minimum": 0 },
                  "summary": { "type": "string" },
                  "detail": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["pass", "partial", "fail", "pending"]
    },
    "rate": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "releaseReceipt": {
      "type": "object",
      "description": "Provenance metadata linking a dashboard snapshot to one frozen release binary and its verification receipts.",
      "properties": {
        "commit": { "type": ["string", "null"] },
        "binarySha256": { "$ref": "#/$defs/sha256" },
        "binarySizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "tarballSha256": { "$ref": "#/$defs/sha256" },
        "wasmSha256": { "$ref": "#/$defs/sha256" },
        "oracleVersion": { "type": ["string", "null"] },
        "generatedAt": { "type": ["string", "null"] },
        "runId": { "type": ["string", "null"] },
        "artifactUrls": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "benchmarkMetric": {
      "type": "object",
      "required": ["label", "value", "unit", "baseline", "status"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "baseline": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "note": { "type": "string" }
      }
    },
    "realGiantBenchmark": {
      "type": "object",
      "required": ["project", "status"],
      "properties": {
        "project": { "type": "string" },
        "repository": { "type": "string" },
        "version": { "type": "string" },
        "coldConfigureSpeedup": { "type": ["number", "null"], "minimum": 0 },
        "warmProbeSpeedup": { "type": ["number", "null"], "minimum": 0 },
        "incrementalLeafP95Ms": { "type": ["number", "null"], "minimum": 0 },
        "rcmakeMedianMs": { "type": ["number", "null"], "minimum": 0 },
        "oracleMedianMs": { "type": ["number", "null"], "minimum": 0 },
        "peakRssMiB": { "type": ["number", "null"], "minimum": 0 },
        "binarySha256": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/status" },
        "note": { "type": "string" }
      }
    },
    "differentialFuzzReport": {
      "type": "object",
      "required": ["status", "total", "passed", "failed", "oracleErrors"],
      "properties": {
        "label": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "seed": { "type": ["integer", "null"] },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "passed": { "type": ["integer", "null"], "minimum": 0 },
        "failed": { "type": ["integer", "null"], "minimum": 0 },
        "oracleErrors": { "type": ["integer", "null"], "minimum": 0 },
        "scriptCases": { "type": ["integer", "null"], "minimum": 0 },
        "configureCases": { "type": ["integer", "null"], "minimum": 0 },
        "families": { "type": ["integer", "null"], "minimum": 0 },
        "binarySha256": { "$ref": "#/$defs/sha256" },
        "note": { "type": "string" }
      }
    }
  }
}
