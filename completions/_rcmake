_rcmake_cache() {
  if (( CURRENT == 2 )); then
    local -a actions
    actions=(
      'status:Show cache size and entry counts (default)'
      'dir:Print the probe cache directory'
      'clear:Remove cache entries, blobs, and staged candidates'
      'export:Write valid probe entries to a portable archive'
      'import:Read probe entries from a portable archive'
    )
    _arguments -s -S \
      '(-h --help)'{-h,--help}'[Show cache help]' \
      '1:action:->action'
    if [[ "$state" == action ]]; then
      _describe -t actions 'cache action' actions
    fi
    return
  fi
  case "${words[2]}" in
    export)
      _arguments -s -S \
        '(-h --help)'{-h,--help}'[Show export help]' \
        '1:archive file:_files'
      ;;
    import)
      _arguments -s -S \
        '--sha256=[Expected 64-hex-digit SHA-256 digest for trusted import]:sha256:' \
        '(-h --help)'{-h,--help}'[Show import help]' \
        '1:archive file:_files'
      ;;
    *)
      _arguments -s -S '(-h --help)'{-h,--help}'[Show help]'
      ;;
  esac
}

