_rcmake() {
  local first="${words[2]}"
  if (( CURRENT >= 3 )); then
    case "$first" in
      explain)
        shift words
        (( CURRENT-- ))
        _rcmake_explain
        return
        ;;
      diff-config)
        shift words
        (( CURRENT-- ))
        _rcmake_diff_config
        return
        ;;
      fmt)
        shift words
        (( CURRENT-- ))
        _rcmake_fmt
        return
        ;;
      lint)
        shift words
        (( CURRENT-- ))
        _rcmake_lint
        return
        ;;
      verify)
        shift words
        (( CURRENT-- ))
        _rcmake_verify
        return
        ;;
      doctor)
        shift words
        (( CURRENT-- ))
        _rcmake_doctor
        return
        ;;
      cache)
        shift words
        (( CURRENT-- ))
        _rcmake_cache
        return
        ;;
      ccmake)
        shift words
        (( CURRENT-- ))
        _rcmake_ccmake
        return
        ;;
      ctest)
        shift words
        (( CURRENT-- ))
        _rcmake_ctest
        return
        ;;
      cpack)
        shift words
        (( CURRENT-- ))
        _rcmake_cpack
        return
        ;;
      lsp)
        shift words
        (( CURRENT-- ))
        _rcmake_lsp
        return
        ;;
      --build)
        shift words
        (( CURRENT-- ))
        _rcmake_build
        return
        ;;
      --install)
        shift words
        (( CURRENT-- ))
        _rcmake_install
        return
        ;;
      --workflow)
        shift words
        (( CURRENT-- ))
        _rcmake_workflow
        return
        ;;
      --open)
        _directories
        return
        ;;
      -E)
        shift words
        (( CURRENT-- ))
        _rcmake_tool_e
        return
        ;;
    esac
  fi

  local -a warning_categories
  warning_categories=(
    dev author deprecated policy strict experimental
    non-target-directive install-absolute-destination uninitialized unused-cli
